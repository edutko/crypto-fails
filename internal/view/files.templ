package view

import (
	"fmt"

	"github.com/edutko/crypto-fails/internal/auth"
    "github.com/edutko/crypto-fails/internal/view/component"
	"github.com/edutko/crypto-fails/pkg/blob"
)

templ MyFiles(files []blob.Metadata) {
<!DOCTYPE html>
<html>
@component.Head()
<body>
<h1>$5wrench Cloud Storage</h1>
<h2>So secure, they'll have to beat your secrets out of you!<sup title="https://xkcd.com/538/"><a href="https://xkcd.com/538/">[1]</a></sup></h2>

<div id="content">
<div id="navbar">
if s := auth.GetCurrentSession(ctx); s != nil {
@component.SideMenu(*s)
}
</div>

<div id="content-main">
<h3>My Files</h3>
<table id="files-table">
<thead>
  <th class="left-justified">Name</th>
  <th class="right-justified">Size</th>
  <th class="centered">Uploaded</th>
  <th class="centered">Actions</th>
</thead>
<tbody>
for _, f := range files {
  <tr>
    <td class="left-justified">{f.Key}</td>
    <td class="right-justified">{fmt.Sprintf("%d", f.Size)}</td>
    <td class="centered">{f.Modified.Format("2006-01-02")}</td>
    <td class="centered">
      <a href={templ.SafeURL("/download?key="+f.Key)} class="link-button" title="Download">⬇︎</a>
      @component.LinkButton("post", "/share", "➦", "Share", map[string]string{"key": f.Key})
    </td>
  </tr>
}
</tbody>
</table>

<br />
<form action="/upload" method="post" enctype="multipart/form-data">
<input type="file" id="file" name="file" required />
<input type="submit" id="submit" value="Upload" />
</form>
</div>
</div>

</body>
</html>
}
